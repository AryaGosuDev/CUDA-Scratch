.vs/
*.VC.db
*.VC.opendb
*.suo
*.user
*.userosscache
*.sln.docstates

# Visual Studio generated folders
Debug/
Release/
x64/
x86/
ARM/
ARM64/

# CMake generated
CMakeFiles/
CMakeCache.txt
cmake_install.cmake
compile_commands.json
CTestTestfile.cmake
Makefile
out/
build/

# ---------------------------------------------------------
